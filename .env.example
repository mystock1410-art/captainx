# ───────────────────────────────────────────────────────────────────────────
# Captain X — environment (self-hosted VPS). Copy to `.env.local` on the server
# and fill in real values. `.env.local` is git-ignored and auto-loaded by
# `next start`.  Nothing here is required for the app to boot — missing pieces
# degrade gracefully (no DB → leads still emailed, collector disabled).
# ───────────────────────────────────────────────────────────────────────────

# Claude API — required for the AI market brief (/api/market-brief, /api/market-analyze AI parts)
ANTHROPIC_API_KEY=

# MySQL (Phase 2+). Use DATABASE_URL *or* the discrete DB_* vars.
# DATABASE_URL=mysql://captainx:password@127.0.0.1:3306/captainx
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=captainx
DB_PASS=
DB_NAME=captainx

# Collector cron (Phase 3) — shared secret guarding /api/internal/collect.
# Generate: openssl rand -hex 24
CRON_SECRET=

# Optional
# LEADS_EMAIL=mystock1410@gmail.com
# LEADS_WEBHOOK_URL=
# SBV_CENTRAL_RATE=25638
# FIREANT_TOKEN=
